# Copy to .env and edit as needed, then export before running:
#   set -a; source .env; set +a
# All values below are also the built-in defaults (config.py), so .env is optional.

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
EMBED_DIM=1024
QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# Embedding backend: "ollama" (default) or "sentence-transformers" (serve a fine-tuned model).
EMBEDDER=ollama

# ollama backend
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b

# sentence-transformers backend (needs `uv sync --group training`).
# EMBED_DIM above must match the model's output dim; use a fresh QDRANT_COLLECTION.
ST_MODEL=outputs/embedding-ft
ST_DEVICE=

# ── Offline tools (datagen / training / evaluation) — all optional ─────────────
# Training pairs: rag-gen-data / rag-gen-synthetic write them, rag-train reads them.
# TRAIN_FILE=data/train.jsonl
# TRAIN_EVAL_FILE=data/test.jsonl
# Synthetic generation (rag-gen-synthetic): source corpus + the LLM that writes queries.
# CORPUS_FILE=data/corpus.jsonl
# GEN_MODEL=qwen3:4b
# N_QUERIES=3
# HARD_NEGATIVES=1
# Evaluation (rag-eval reads EVAL_DIR; rag-gen-eval writes a sample BEIR set there).
# See docs/evaluation.md for the data contract.
# EVAL_DIR=data/eval
# N_DISTRACTORS=          # cap the sample haystack size (blank = use all)
