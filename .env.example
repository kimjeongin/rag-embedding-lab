# Copy to .env and edit as needed, then export before running:
#   set -a; source .env; set +a
# All values below are also the built-in defaults (config.py), so .env is optional.

EMBED_DIM=1024
QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# Embedding backend: "ollama" (default) or "sentence-transformers" (serve a fine-tuned model).
EMBEDDER=ollama

# ollama backend
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b

# sentence-transformers backend (needs `uv sync --group training`).
# EMBED_DIM above must match the model's output dim.
ST_MODEL=outputs/embedding-ft
ST_DEVICE=

# ── Offline tools (datagen / training / evaluation) — all optional ─────────────
# Site crawl (rag-crawl <url>): pages → CORPUS_FILE, page = retrieval unit.
# CRAWL_URL=               # alternative to the CLI argument
# CRAWL_MAX_PAGES=300
# CRAWL_DELAY=0.4          # seconds between fetches (politeness)
# CRAWL_MIN_CHARS=200      # thinner pages (nav/list) are skipped
# CRAWL_MAX_CHARS=2000     # page-text cap — the FirstP cut
# Training pairs: rag-gen-data / rag-gen-synthetic write them, rag-train reads them.
# TRAIN_FILE=data/train.jsonl
# TRAIN_EVAL_FILE=data/test.jsonl
# Fine-tuning method: "full" (default, all params) or "lora" (low-rank adapters, merged
# into the base on save so the output is a normal model either way).
# TRAIN_METHOD=full
# LoRA knobs (used only when TRAIN_METHOD=lora):
# TRAIN_LORA_R=16
# TRAIN_LORA_ALPHA=32
# TRAIN_LORA_DROPOUT=0.05
# Synthetic generation (rag-gen-synthetic): source corpus + the LLM that writes queries.
# CORPUS_FILE=data/corpus.jsonl
# GEN_MODEL=qwen3.5:2b
# N_QUERIES=3
# HARD_NEGATIVES=1
# ROUND_TRIP_K=1           # consistency filter, TRAIN split only (0 = off)
# NEG_MARGIN=0.05          # false-negative guard in hard-negative mining (0 = off)
# Evaluation (rag-eval reads EVAL_DIR; rag-gen-eval writes a BEIR set there).
# See docs/evaluation.md for the data contract.
# EVAL_SOURCE=sample       # sample (toy gold + distractors) | corpus (crawled site = haystack)
# EVAL_DIR=data/eval
# N_DISTRACTORS=           # sample mode: cap the haystack size (blank = use all)
